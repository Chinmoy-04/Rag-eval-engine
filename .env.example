# LLM provider: groq | openai | anthropic
LLM_PROVIDER=groq

# API keys (set the one matching your provider)
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model names
# Groq retired llama-3.1-8b-instant on 2026-08-16 (free/developer tiers).
# Replacement: openai/gpt-oss-20b. Stronger: openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-20b
# Optional override for Ragas testset generation only.
# Default on Groq: qwen/qwen3.6-27b (reasoning_effort=none; fits free-tier TPM).
# TESTSET_LLM_MODEL=qwen/qwen3.6-27b
# Optional override for Ragas *scoring* judge (Phase 6). Falls back to TESTSET_LLM_MODEL.
# EVAL_LLM_MODEL=qwen/qwen3.6-27b
# Embedding backend: local (ONNX MiniLM, no API key) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Chroma / ingestion
CHROMA_COLLECTION=rag_eval_corpus
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DEFAULT_TOP_K=4

# Evaluation
EVAL_CONCURRENCY=8
EVAL_MAX_RETRIES=3

# Database
DATABASE_URL=sqlite:///data/rag_eval.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/rag_eval.log
